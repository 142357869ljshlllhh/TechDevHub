# 通用微服务 Dockerfile（2G 服务器专用，极小内存占用）
# 用法（在 docker-compose.micro.yml 中按服务传 ARG SERVICE_JAR）：
#   build:
#     context: ..
#     dockerfile: deploy/Dockerfile.service
#     args:
#       SERVICE_JAR: techdevhub-user/target/techdevhub-user-0.0.1-SNAPSHOT.jar
FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="techdevhub"

# 时区
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apk del tzdata

WORKDIR /app

# SERVICE_JAR 由 compose 的 build.args 传入（指向 mvn package 产出的 fat jar）
ARG SERVICE_JAR
COPY ${SERVICE_JAR} app.jar

# JVM 调优（2G 服务器关键参数）：
#   -Xms48m -Xmx128m   最小/最大堆，控制在 128MB 内
#   -XX:+UseSerialGC    小堆用串行 GC，比 G1 省内存、无并发线程开销
#   -XX:MaxMetaspaceSize=96m  限制元空间
#   -XX:ReservedCodeCacheSize=32m  限制代码缓存
#   -Djava.security.egd=file:/dev/./urandom  加快随机数采集，避免启动卡顿
ENV JAVA_OPTS="-Xms48m -Xmx128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=32m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heap.hprof -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
