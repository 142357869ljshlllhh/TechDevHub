# 编译产物：jar 不进 git（部署走本地打包后 scp，或服务器构建）
**/target/

# 环境变量 / 密钥：绝不进 git
.env
deploy/.env

# 前端构建产物（由 TechDevHub-Front 构建后拷入，不版本化）
deploy/frontend-dist/

# 项目排除路径
/techdevhub-category/target/
/techdevhub-comment/target/
/techdevhub-follow/target/
/techdevhub-gateway/target/
/techdevhub-like/target/
# WorkBuddy 项目数据（记忆/日志等）：本地保留，不进版本库
/.workbuddy/
